<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if title %}
    <title>{{ title }} | Modesto Software</title>
    {% else %}
    <title>Modesto Software</title>
    {% endif %}

    <meta name="description" content="{{metaDescription}}">
    <meta name="author" content="{{ site.fullName }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Modesto Software">
    <meta property="og:title" content="{{ title or 'Modesto Software' }}">
    {% if metaDescription %}
    <meta property="og:description" content="{{ metaDescription }}">
    {% endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ image or '/images/profile-2024.png' }}">
    <meta name="twitter:card" content="summary">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% endif %}
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' https://gc.zgo.at;
      connect-src 'self' https://modestosoftware.goatcounter.com;
      img-src 'self' https://modestosoftware.goatcounter.com;
      font-src 'self';
      style-src 'self' 'unsafe-inline';
      object-src 'none';
      base-uri 'self';
      form-action 'self';
    ">

    <meta
      class="meta-theme"
      name="theme-color"
    />
    <meta
      class="meta-theme"
      name="color-scheme"
    />

    <link rel="icon" href="/favicon.ico">
    <link rel="icon" href="/modesto_software_favicon_for_light_mode.ico" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/modesto_software_favicon_for_dark_mode.ico" media="(prefers-color-scheme: dark)">

    <script src="/js/initTheme.js"></script>

    <link href="/output.css" rel="stylesheet">
    <link href="/css/print.css" rel="stylesheet" media="print"/>

    {% if css %}
    <link rel="stylesheet" href="{{css}}" />
    {% endif %}

    {% for jsFilePath in jsModuleFiles %}
    <script type="module" src="{{ jsFilePath }}"></script>
    {% endfor %}

    <script type="module" src="/js/handleThemeToggleEvents.js"></script>

    {% for jsFilePath in jsScriptFiles %}
    <script src="{{ jsFilePath }}"></script>
    {% endfor %}

    {% for jsFilePath in jsScriptAsyncFiles %}
    <script src="{{ jsFilePath }}" async defer></script>
    {% endfor %}

    <!-- GoatCounter: cookieless analytics, see README -->
    <script data-goatcounter="https://modestosoftware.goatcounter.com/count" async src="https://gc.zgo.at/count.v4.js"
      crossorigin="anonymous" integrity="sha384-nRw6qfbWyJha9LhsOtSb2YJDyZdKvvCFh0fJYlkquSFjUxp9FVNugbfy8q1jdxI+"></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Header -->
    <header class="bg-base-200">
      <div class="navbar pl-1 pr-4 md:px-6">

        <!-- Desktop menu -->
        <div class="navbar-start hidden md:flex flex-wrap items-center justify-between py-2">
          <div class="hidden md:flex flex-wrap items-center space-x-4">
          {% for menuItem in menuItems %}
            {% if(page.url === menuItem.link) %}
            <div class="btn btn-sm sm:btn-md btn-neutral cursor-not-allowed">{{ menuItem.name }}</div>
            {% else %}
            <a href="{{ menuItem.link }}" class="btn btn-sm sm:btn-md btn-primary">{{ menuItem.name }}</a>
            {% endif %}
          {% endfor %}
          </div>
        </div>

        <!-- Mobile menu -->
        <div class="navbar-start md:hidden">
          <div class="dropdown">
            <div tabindex="0" role="button" class="btn">{% include "icons/menu.svg" %}</div>
            <ul tabindex="0" class="menu dropdown-content z-1 p-2 shadow-sm bg-base-300 rounded-box w-52 border border-gray-300">
            {% for menuItem in menuItems %}
              <li>
                {% if(page.url === menuItem.link) %}
                <div>{{ menuItem.name }}</div>
                {% else %}
                <a href="{{ menuItem.link }}">{{ menuItem.name }}</a>
                {% endif %}
              </li>
            {% endfor %}
            </ul>
          </div>
        </div>

        <!-- Theme toggle and logo -->
        <div class="navbar-end">
          <div class="flex items-center space-x-3 md:space-x-6">
            <!-- Theme Toggle -->
            <label for="theme-toggle" class="sr-only">Toggle Theme</label>
            <input type="checkbox" class="toggle toggle-sm md:toggle-md" id="theme-toggle"/>

            <!-- Company Logo -->
            {% if(page.url === "/") %}
            <div class="flex items-center">
              <img src="/images/modesto_software_logo_for_light_mode.webp" alt="Company Logo" class="dark:hidden w-10 md:w-14 h-auto"/>
              <img src="/images/modesto_software_logo_for_dark_mode.webp" alt="Company Logo" class="hidden dark:block w-10 md:w-14 h-auto"/>
            </div>
            {% else %}
            <a href="/" class="flex items-center">
              <img src="/images/modesto_software_logo_for_light_mode.webp" alt="Company Logo" class="dark:hidden w-10 md:w-14 h-auto"/>
              <img src="/images/modesto_software_logo_for_dark_mode.webp" alt="Company Logo" class="hidden dark:block w-10 md:w-14 h-auto"/>
            </a>
            {% endif %}
          </div>
        </div>

      </div>
    </header>

    <!-- Main Content Area -->
    <main class="grow flex justify-center">
      {# Responsive width: 10/12 mobile+tablet | 11/12 desktop #}
      <div id="main-container" class="w-10/12 xl:w-11/12 pt-4 pb-6 md:pt-6 md:pb-8">
        {% if pageHeader %}
        <h1 class="text-2xl text-center font-bold mb-2">{{ pageHeader }}</h1>
        {% endif %}
        {% if subHeader %}
        <h2 class="text-xl text-center mb-3">{{ subHeader }}</h2>
        {% endif %}
        {{ content | safe }}
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-base-200 p-4 text-center shadow-md">
      <p>© {% currentYear %} Modesto Software AB. All rights reserved.</p>
    </footer>

  </body>
</html>
