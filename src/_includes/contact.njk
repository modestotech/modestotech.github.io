---
jsModuleFiles:
  - '/js/populateContactPage.js'
layout: base.njk
---

<p class="text-center">Nice that you want to get in touch!</p>

<div id="card-container" class="card card-sm">
    <div class="card-body items-center text-center text-blue-600">
        <div id="contact-container" class="space-y-4">
            <!-- Email -->
            <div data-contact="email" class="flex items-center space-x-2 text-lg">
                <i class="bx bxs-envelope bx-sm"></i>
            </div>

            <!-- Phone -->
            <div data-contact="phone" class="flex items-center space-x-2 text-lg">
                <i class="bx bxs-phone bx-sm"></i>
            </div>

            <!-- LinkedIn -->
            <div data-contact="linkedin" class="flex items-center space-x-2 text-lg">
                <i class="bx bxl-linkedin bx-sm"></i>
            </div>

            <!-- Github -->
            <div data-contact="github" class="flex items-center space-x-2 text-lg">
                <i class="bx bxl-github bx-sm"></i>
            </div>
        </div>
    </div>
</div>